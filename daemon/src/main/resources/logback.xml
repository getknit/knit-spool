<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <appender name="console" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{ISO8601} %-5level %logger{24} %msg%n</pattern>
        </encoder>
    </appender>
    <root level="${SPOOL_LOG_LEVEL:-INFO}">
        <appender-ref ref="console"/>
    </root>
</configuration>
