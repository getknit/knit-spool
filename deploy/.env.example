# Copy to deploy/.env for docker-compose.tls.yml. Never commit the filled-in copy.

# Required. Must already resolve to this host — ACME issuance fails otherwise.
SPOOL_DOMAIN=spool.example.com

# Required. Let's Encrypt expiry notices go here.
ACME_EMAIL=ops@example.com

# Used by docker-compose.tiny.yml, which pulls the image rather than building it. Set this to
# a registry reference to pull from a private registry (`docker login` first, as the user that
# runs compose). Pin an immutable tag or digest so a restart brings back the same daemon;
# `latest` moves under you, and a @sha256: digest is the strictest form. Release images are
# multi-arch (amd64, arm64) and published to both registries below; a private registry works too,
# `docker login` first.
#SPOOL_IMAGE=ghcr.io/getknit/knit-spool:0.6.1
#SPOOL_IMAGE=docker.io/getknit/knit-spool@sha256:...

# Optional. Set = private Spool: clients connect to
# wss://$SPOOL_DOMAIN/spool/v1?k=<token>. Empty = public Spool.
SPOOL_TOKEN=

# Optional. A SECOND accepted credential, so rotating one does not lock every client out at
# once: set it, migrate clients to it, promote it to SPOOL_TOKEN, then clear it. Both are
# accepted while both are set. Setting it with no SPOOL_TOKEN refuses to boot.
#SPOOL_TOKEN_NEXT=

# Optional. The ?k= credential for /metrics, kept separate from SPOOL_TOKEN so a scrape does
# not need the secret your clients connect with — and so a client holding that secret cannot
# read the Spool's scope counts and traffic shape. Setting it replaces SPOOL_TOKEN on /metrics.
#SPOOL_METRICS_TOKEN=

# Optional overrides; the compose file's defaults are shown.
#SPOOL_POW_BITS=20
#SPOOL_MAX_BYTES=268435456
#SPOOL_LOG_LEVEL=INFO
# Periodic status line in the container log; 0 turns it off.
#SPOOL_STATUS_MS=300000

# Optional. AGPL §13: if you run a MODIFIED build, publish it and point this at your repository,
# so GET /source offers your source rather than upstream's. Unmodified, leave it alone.
#SPOOL_SOURCE_URL=https://example.com/your/fork


# Optional. The KEY=value file SIGHUP re-reads, layered over the environment, so quotas and
# credentials change without the restart that drops every live connection. It must be on the
# volume to survive a recreate. Reloadable immediately: the three tokens, SPOOL_MAX_CONNS,
# SPOOL_MAX_BYTES. On the next connection: SPOOL_POW_BITS, SPOOL_MAX_RECORD, SPOOL_MAX_PULL,
# SPOOL_MAX_AGET, SPOOL_RATE_*, SPOOL_MAX_CONNS_PER_IP, SPOOL_REQUIRE_MODERATION,
# SPOOL_STUN_URLS, SPOOL_TICKET_*, SPOOL_MAX_CAST. SPOOL_RATE_CASTS=0 stops casts at once, and
# SPOOL_RATE_CASTS_TOTAL bites immediately. Anything else is logged as ignored and needs a restart.
#SPOOL_RELOAD_FILE=/data/reload.env

# Optional. Total live connections; over it the WebSocket upgrade is refused 503 + Retry-After
# rather than accepted into a box with no room. 0 = unlimited. docker-compose.tiny.yml sets
# 2000 for a 1 GB host.
#SPOOL_MAX_CONNS=0

# Optional. Send-side moderation (spec §7.5). true asks every client on this Spool to run its
# on-device content screen before sending and to refuse what it flags, with no "send anyway".
# The Spool cannot check it — it holds ciphertext — so this is a request to conforming clients,
# not an enforcement. Receiving is unaffected: what a member hides or reveals stays their own.
#SPOOL_REQUIRE_MODERATION=false

# Optional. The commons (spec §7.4): shared rooms, up to eight per Spool, where everyone holding
# a room's invite can talk to everyone else in it, still sealed end to end. Unset = no commons at
# all. Mint each invite with `knit-spool commons-invite`; it prints the secret to give members and
# the id below. The Spool is only ever given the id, so it relays a room it cannot read.
#SPOOL_COMMONS_ID=<64 hex characters>
# Advertised in every client's hello only when SPOOL_TOKEN is set: on an open Spool anyone who
# connects would read it. Members always get it from the link `commons-invite --url` prints.
#SPOOL_COMMONS_NAME=The Commons
# Operator-pinned bounds, because the store applies whatever the most recent subscriber asked
# for and one member requesting maxFrames=1 would otherwise evict the whole room's history.
#SPOOL_COMMONS_MAX_FRAMES=500
#SPOOL_COMMONS_TTL_MS=86400000
# Defaults to SPOOL_MAX_BLOB; it may not exceed it.
#SPOOL_COMMONS_MAX_BLOB=
#SPOOL_COMMONS_ATTACH=false
# The room's own budget, not per connection: 200 members at 10 pushes/s each is 2,000/s into one
# scope. Throttles without striking the connection — congestion in a shared room is not one
# member's fault.
#SPOOL_COMMONS_RATE_PUSHES=20
# Every room together, beside each room's own budget. Defaults to 40, or the largest room's
# SPOOL_COMMONS_RATE_PUSHES if that is higher.
#SPOOL_COMMONS_RATE_TOTAL=40
# A second room, and so on up to SPOOL_COMMONS_8_*: the same settings, numbered. Each has its own
# invite (`knit-spool commons-invite --room 2`), bounds and budget. Give it the first room's
# TTL_MS: clients that predate rooms take a room with a different one for a rotated room.
#SPOOL_COMMONS_2_ID=<64 hex characters>
#SPOOL_COMMONS_2_NAME=The Den

# Optional, experimental. TURN for Knit voice calls (SPOOL_PROTOCOL.md §7.6). The Spool hands
# subscribed clients short-lived relay credentials signed with this secret, and coturn — run by
# docker-compose.turn.yml as the last -f — checks them with the same value. The Spool never
# carries media. Unset = no TURN, and the three below must then stay unset too.
#   openssl rand -base64 48
#SPOOL_TURN_SECRET=
# What clients are told to dial. The overlay defaults to UDP on 3478 and TLS on 5349 at SPOOL_DOMAIN,
# one URL per transport (S-7.6-25): every URL costs a phone an allocation per network. Set this
# only to change that list or to point at a TURN server elsewhere; what you set is used as is.
#SPOOL_TURN_URLS=turn:spool.example.com:3478?transport=udp,turns:spool.example.com:5349?transport=tcp
# Credential lifetime in seconds (60-3600): how long it can START a relay. coturn checks it only
# when a session first allocates, so a call carries on past it. Short keeps a leaked one cheap.
#SPOOL_TURN_TTL_S=300
# More TURN boxes, up to SPOOL_TURN_4_*: each its own coturn on a host of its own, with its own
# secret. Phones measure every box from where they are and ask for the nearest, so a second box
# adds capacity instead of mirroring the first. Old clients get server 1, the unnumbered one. With
# two or more, each server's URLs name one host and include a turn: URL over UDP. See HOSTING.md.
#SPOOL_TURN_2_SECRET=
#SPOOL_TURN_2_URLS=turn:eu.turn.example.com:3478?transport=udp,turns:eu.turn.example.com:5349?transport=tcp
# Optional, experimental. STUN URIs every client is told in hello, with no credential: how a phone
# with no TURN of its own learns the public address a paying peer's relay must permit. Needs no
# secret; the TURN overlay defaults it to its own coturn on 3478. At most 4.
#SPOOL_STUN_URLS=stun:spool.example.com:3478
# Optional, experimental. Entitlement tickets: with a key, hello carries `ent` and turnreq needs a
# ticket signed by its private half, so paying callers are told apart and coturn's user-quota counts
# each one. `knit-spool ticket-keygen` prints a pair; only the PUBLIC key goes here. Both or neither.
#SPOOL_TICKET_KEY=
#SPOOL_TICKET_AUDIENCE=spool.example.com
# Renaming the spool: while both names reach it, put the new one in SPOOL_TICKET_AUDIENCE and the
# old one here, so tickets for either are accepted. Clear it once every client has moved. SIGHUP-reloadable.
#SPOOL_TICKET_AUDIENCE_ALIAS=old.example.com
# Rotating the issuer key: set the new public key here, start signing with it once every spool has
# it, wait out the longest ticket, then move it into SPOOL_TICKET_KEY and clear this. SIGHUP-reloadable.
#SPOOL_TICKET_KEY_NEXT=
# Which capabilities a ticket gates: turn, files, cast. Unset is turn,cast. Add files to make
# sending attachments need a ticket minted with --files; receiving them never does.
#SPOOL_TICKET_GATES=turn,cast,files
# With files gated, the bytes one ticket holder may upload a day, whatever its ticket claims. A
# holder keeps at most three days of it at the 48 h attachment retention. 32 MiB by default.
#SPOOL_TICKET_ATTACH_BYTES=33554432
# With TURN on, the credentials one ticket holder may fetch per ten minutes across all its
# connections and addresses, on top of the per-connection and per-address limits. 0 = off.
#SPOOL_TICKET_TURN_RATE=16
# Optional, experimental. Casts: a walkie-talkie's chunks, fanned out live to the other
# subscribers of a conversation and never stored, for two phones with no radio path. Casts per
# connection per second (burst 4x; an honest walkie sends about 2). 0 = off, the default. With a
# ticket key, a cast needs a subscriber of its scope holding a ticket minted with --cast.
#SPOOL_RATE_CASTS=4
# The largest cast, in bytes; a sealed walkie chunk is about 800.
#SPOOL_MAX_CAST=2048
# Casts per second the whole Spool accepts (burst 4x). Each leaves once per other subscriber of
# its conversation, two members for a DM, so egress is this times the cast size times that.
#SPOOL_RATE_CASTS_TOTAL=200
# Credentials per connection per 10 minutes; one address gets four times this.
#SPOOL_TURN_RATE=4
# coturn, behind NAT only: the public address (or public/private). A VPS with a public IP
# directly on its interface needs nothing here.
#TURN_EXTERNAL_IP=
# The UDP relay range. Each allocation takes one port; open the range on the firewall.
#TURN_MIN_PORT=49160
#TURN_MAX_PORT=49999
# The abuse bounds. On a public Spool anyone can get a credential, so these — not the credential —
# are what limit a stranger. Bandwidth is BYTES per second; one call leg is ~7000 with headers.
# coturn reserves TURN_MAX_BPS from TURN_BPS_CAPACITY per allocation: keep capacity >= total x max.
#TURN_USER_QUOTA=3
#TURN_TOTAL_QUOTA=100
#TURN_MAX_BPS=16000
#TURN_BPS_CAPACITY=1600000
