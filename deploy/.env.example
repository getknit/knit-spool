# Copy to deploy/.env for docker-compose.tls.yml. Never commit the filled-in copy.

# Required. Must already resolve to this host — ACME issuance fails otherwise.
SPOOL_DOMAIN=spool.example.com

# Required. Let's Encrypt expiry notices go here.
ACME_EMAIL=ops@example.com

# Used by docker-compose.tiny.yml, which pulls the image rather than building it. Set this to
# a registry reference to pull from a private registry (`docker login` first, as the user that
# runs compose). Pin an immutable tag or digest so a restart brings back the same daemon;
# `latest` moves under you, and a @sha256: digest is the strictest form. Release images are
# multi-arch (amd64, arm64) and published to both registries below; a private registry works too,
# `docker login` first.
#SPOOL_IMAGE=ghcr.io/getknit/knit-spool:v0.2.0
#SPOOL_IMAGE=docker.io/getknit/knit-spool@sha256:...

# Optional. Set = private spool: clients connect to
# wss://$SPOOL_DOMAIN/spool/v1?k=<token>. Empty = public spool.
SPOOL_TOKEN=

# Optional. A SECOND accepted credential, so rotating one does not lock every client out at
# once: set it, migrate clients to it, promote it to SPOOL_TOKEN, then clear it. Both are
# accepted while both are set. Setting it with no SPOOL_TOKEN refuses to boot.
#SPOOL_TOKEN_NEXT=

# Optional. The ?k= credential for /metrics, kept separate from SPOOL_TOKEN so a scrape does
# not need the secret your clients connect with — and so a client holding that secret cannot
# read the spool's scope counts and traffic shape. Setting it replaces SPOOL_TOKEN on /metrics.
#SPOOL_METRICS_TOKEN=

# Optional overrides; the compose file's defaults are shown.
#SPOOL_POW_BITS=20
#SPOOL_MAX_BYTES=268435456
#SPOOL_LOG_LEVEL=INFO
# Periodic status line in the container log; 0 turns it off.
#SPOOL_STATUS_MS=300000

# Optional. AGPL §13: if you run a MODIFIED build, publish it and point this at your repository,
# so GET /source offers your source rather than upstream's. Unmodified, leave it alone.
#SPOOL_SOURCE_URL=https://example.com/your/fork


# Optional. The KEY=value file SIGHUP re-reads, layered over the environment, so quotas and
# credentials change without the restart that drops every live connection. It must be on the
# volume to survive a recreate. Reloadable immediately: the three tokens, SPOOL_MAX_CONNS,
# SPOOL_MAX_BYTES. On the next connection: SPOOL_POW_BITS, SPOOL_MAX_RECORD, SPOOL_MAX_PULL,
# SPOOL_MAX_AGET, SPOOL_RATE_*. Anything else is logged as ignored and needs a restart.
#SPOOL_RELOAD_FILE=/data/reload.env

# Optional. Total live connections; over it the WebSocket upgrade is refused 503 + Retry-After
# rather than accepted into a box with no room. 0 = unlimited. docker-compose.tiny.yml sets
# 2000 for a 1 GB host.
#SPOOL_MAX_CONNS=0

# Optional. The commons (spec §7.4): ONE shared scope per spool, where everyone holding the
# invite can talk to everyone else, still sealed end to end. Unset = no commons at all.
# Mint the invite with `knit-spool commons-invite`; it prints the secret to give members and
# the id below. The spool is only ever given the id, so it relays a room it cannot read.
#SPOOL_COMMONS_ID=<64 hex characters>
#SPOOL_COMMONS_NAME=The Commons
# Operator-pinned bounds, because the store applies whatever the most recent subscriber asked
# for and one member requesting maxFrames=1 would otherwise evict the whole room's history.
#SPOOL_COMMONS_MAX_FRAMES=500
#SPOOL_COMMONS_TTL_MS=86400000
# Defaults to SPOOL_MAX_BLOB; it may not exceed it.
#SPOOL_COMMONS_MAX_BLOB=
#SPOOL_COMMONS_ATTACH=false
# Spool-wide, not per connection: 200 members at 10 pushes/s each is 2,000/s into one scope.
# Throttles without striking the connection — congestion in a shared room is not one member's
# fault.
#SPOOL_COMMONS_RATE_PUSHES=20
