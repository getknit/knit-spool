# Caddy terminates TLS and proxies WebSocket upgrades automatically.
# Pair with SPOOL_TRUST_PROXY=true so per-IP limits see the real client address.
# To have compose bring Caddy up too, use ./docker-compose.tls.yml + ./Caddyfile.compose.
spool.example.com {
	# /metrics leaks no ciphertext but does expose scope counts and traffic shape, and
	# the daemon only token-gates it on private spools. Sealed at the edge by default;
	# scrape http://127.0.0.1:9470/metrics on the host instead.
	respond /metrics 404

	# /source is deliberately NOT sealed here. It is the AGPL §13 offer — the running version, its
	# commit, and where to get the source — and it must be reachable by the people whose clients
	# connect. It discloses nothing about traffic, scopes, or who is connected.

	reverse_proxy 127.0.0.1:9470 {
		# The daemon pings every 30 s and gives up at 60 s; leave the proxy's read side
		# open past that so idle-but-healthy subscriber connections are not cut here.
		transport http {
			read_timeout 0
		}
	}

	# A spool is blinded by design — do not let the proxy log undo that. Caddy logs
	# access by default, and the default fields would record the bearer token (it
	# rides in ?k=), the exact client address, and a fingerprintable User-Agent.
	log {
		output stderr
		format filter {
			wrap console
			fields {
				request>uri query {
					delete k
				}
				request>remote_ip ip_mask {
					ipv4 24
					ipv6 48
				}
				request>client_ip ip_mask {
					ipv4 24
					ipv6 48
				}
				request>headers>User-Agent delete
			}
		}
	}
}
