# Knit Spool on this box (ADR 2026-11.zmc3). What is here is the box's business: whether, where and
# how big. Everything the daemon itself understands (tokens, quotas, rooms, TURN, tickets) goes in
# /etc/knit-spool/env, which `service knit-spool reload` re-reads live; a change here needs
# `service knit-spool restart`.

config knit-spool 'main'
	# 0 until /etc/knit-spool/env has a token and data_dir points where you want it.
	option enabled '0'
	option port '9470'
	# The address the listener binds. 127.0.0.1 keeps the plaintext WebSocket off the LAN; a TLS
	# proxy on this box (nginx-ssl, see /etc/nginx/conf.d/knit-spool.conf.example) is what the
	# Internet reaches. 0.0.0.0 exposes it to every interface the firewall lets through.
	option bind '127.0.0.1'
	# Empty: the in-memory store, which forgets every frame on a restart and wears nothing. A
	# directory on the NVMe or a USB disk gives the SQLite store; the flash overlay is the wrong
	# place for it, and the service says so in the log.
	option data_dir ''
	# The daemon's reload file: KEY=value lines, every SPOOL_* setting the README lists.
	option env_file '/etc/knit-spool/env'
	# The heap cap in MB. 128 fits a 1 GB router with room for everything else it runs.
	option heap_mb '128'
	option log_level 'INFO'
	# Open files: a couple per connection plus the store. 8192 is far above what a home spool holds.
	option nofile '8192'
