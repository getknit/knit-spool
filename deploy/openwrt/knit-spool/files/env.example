# /etc/knit-spool/env: the daemon's reload file (SPOOL_RELOAD_FILE), layered over the environment
# the init script builds from /etc/config/knit-spool. KEY=value lines, no quotes, no `export`;
# # comments and blank lines are skipped. Every SPOOL_* variable in the README's configuration table
# is valid here. `service knit-spool reload` applies a change without a restart (what applies at
# once and what waits for the next connection is in the README under "Reloading configuration"),
# and a blank value unsets what the environment set.
#
# Readable by root and the knit-spool group only: the tokens here are the Spool's credentials.

# The bearer token. Unset = a public Spool, usable by anyone who finds the URL. Set it before
# enabling the service, and give members the wss://<host>/spool/v1?k=<token> URL.
#SPOOL_TOKEN=

# Behind nginx on this box: trust the X-Forwarded-For hop the proxy appends, so the per-address
# limits see clients rather than 127.0.0.1. Boot-only; wrong if nothing is in front.
SPOOL_TRUST_PROXY=true

# Proof of work for unknown scopes. The spec suggests 20; 0 is off.
#SPOOL_POW_BITS=20

# Live connections the box will hold; over it the upgrade is refused 503 + Retry-After.
#SPOOL_MAX_CONNS=500

# A commons room: `knit-spool commons-invite` prints the id for this line and the invite for members.
#SPOOL_COMMONS_ID=
#SPOOL_COMMONS_NAME=
